<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Happy Anniversary!</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Great+Vibes&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Cairo', sans-serif;
      color: #1e293b;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow-x: hidden;
      position: relative;
      background: radial-gradient(circle at center, #1b4332 0%, #0f281e 50%, #081c24 100%) !important;
    }

    #glitter-canvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      pointer-events: none;
      z-index: 0;
    }

    .container {
      position: relative;
      z-index: 1;
      background: rgba(255, 255, 255, 0.93);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-radius: 28px;
      padding: 35px 25px;
      max-width: 520px;
      width: 90%;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5), 0 0 30px rgba(45, 106, 79, 0.4);
      text-align: center;
      border: 2px solid rgba(255, 255, 255, 0.8);
      margin: 20px auto;
    }

    .title-calligraphy {
      font-family: 'Great Vibes', cursive;
      font-size: 3.5rem;
      color: #2d6a4f;
      text-shadow: 1px 2px 4px rgba(0,0,0,0.1);
      margin-bottom: 5px;
      line-height: 1.2;
    }

    .title-arabic {
      font-size: 2.2rem;
      font-weight: 700;
      color: #2d6a4f;
      margin-bottom: 8px;
    }

    .subtitle {
      font-size: 1.1rem;
      color: #475569;
      margin-bottom: 25px;
      line-height: 1.5;
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
      margin-bottom: 20px;
    }

    .card-btn {
      background: #f97316;
      color: #ffffff;
      border: none;
      border-radius: 22px;
      padding: 30px 15px;
      font-size: 2.5rem;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 8px 18px rgba(249, 115, 22, 0.35);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .card-btn:hover {
      transform: translateY(-4px) scale(1.03);
      background: #ea580c;
      box-shadow: 0 10px 22px rgba(234, 88, 12, 0.45);
    }

    .card-btn.visited {
      background: #2d6a4f !important;
      color: #ffffff !important;
      box-shadow: 0 8px 18px rgba(45, 106, 79, 0.4) !important;
    }

    .page {
      display: none;
      animation: fadeIn 0.4s ease-in-out;
    }

    .page.active {
      display: block;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Envelope Styling */
    .envelope-interactive {
      width: 140px;
      height: 140px;
      margin: 15px auto;
      cursor: pointer;
      transition: transform 0.3s ease;
    }
    .envelope-interactive:hover { transform: scale(1.08); }

    .letter-content {
      display: none;
      text-align: right;
      background: #f8fafc;
      padding: 22px;
      border-radius: 18px;
      margin-bottom: 20px;
      max-height: 380px;
      overflow-y: auto;
      border: 1px solid #e2e8f0;
    }

    .letter-text {
      font-size: 1.15rem;
      line-height: 1.8;
      color: #1e293b;
      white-space: pre-line;
    }

    /* Reasons Box */
    .reason-box {
      background: #f0fdf4;
      border: 2px dashed #40916c;
      padding: 25px;
      border-radius: 20px;
      font-size: 1.25rem;
      font-weight: 600;
      color: #1b4332;
      min-height: 120px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 20px 0;
      box-shadow: inset 0 0 10px rgba(64, 145, 108, 0.15);
      transition: all 0.3s;
    }

    /* Vinyl Player Styling */
    .vinyl-container {
      position: relative;
      width: 200px;
      height: 200px;
      margin: 20px auto;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .vinyl-record {
      width: 180px;
      height: 180px;
      background: radial-gradient(circle, #2d3748 18%, #0f172a 20%, #1e293b 40%, #0f172a 60%, #1e293b 80%, #020617 100%);
      border-radius: 50%;
      box-shadow: 0 8px 20px rgba(0,0,0,0.4);
      display: flex;
      justify-content: center;
      align-items: center;
      animation: spin 3s linear infinite;
      animation-play-state: paused;
    }

    .vinyl-record.playing {
      animation-play-state: running;
    }

    .vinyl-center {
      width: 60px;
      height: 60px;
      background: #f97316;
      border-radius: 50%;
      border: 4px solid #fff;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .vinyl-center i {
      color: #fff;
      font-size: 1.2rem;
    }

    @keyframes spin {
      100% { transform: rotate(360deg); }
    }

    .action-btn, .back-btn {
      background: #2d6a4f;
      color: white;
      border: none;
      padding: 12px 28px;
      border-radius: 25px;
      font-size: 1.1rem;
      font-weight: 600;
      cursor: pointer;
      box-shadow: 0 4px 12px rgba(45, 106, 79, 0.35);
      transition: background 0.3s, transform 0.2s;
      margin-top: 10px;
    }
    
    .action-btn {
      background: #f97316;
      box-shadow: 0 4px 12px rgba(249, 115, 22, 0.35);
    }

    .action-btn:hover {
      background: #ea580c;
      transform: scale(1.05);
    }

    .back-btn:hover {
      background: #1b4332;
      transform: scale(1.05);
    }
  </style>
</head>
<body>

  <canvas id="glitter-canvas"></canvas>

  <div class="container">
    
    <!-- HOME PAGE -->
    <div id="home-page" class="page active">
      <h1 class="title-calligraphy">Happy Anniversary!</h1>
      <p class="subtitle">ذكرى سنوية سعيدة لأجمل شخص ✨</p>

      <div class="grid">
        <button class="card-btn" id="btn-1" onclick="openGift(1)">
          <i class="fa-solid fa-envelope"></i>
        </button>
        <button class="card-btn" id="btn-2" onclick="openSpotify()">
          <i class="fa-solid fa-headphones"></i>
        </button>
        <button class="card-btn" id="btn-3" onclick="openGift(3)">
          <i class="fa-solid fa-wand-magic-sparkles"></i>
        </button>
        <button class="card-btn" id="btn-4" onclick="openGift(4)">
          <i class="fa-solid fa-record-vinyl"></i>
        </button>
      </div>
    </div>

    <!-- PAGE 1: LETTER -->
    <div id="page-1" class="page">
      <h2 class="title-arabic">رسالة الذكرى السنوية 💌</h2>
      
      <div id="envelope-wrapper">
        <div class="envelope-interactive" onclick="openLetterAnimation()">
          <svg viewBox="0 0 100 100" width="100%" height="100%">
            <path d="M 10 30 L 50 60 L 90 30 L 90 75 L 10 75 Z" fill="#2d6a4f" />
            <path d="M 10 30 L 50 60 L 90 30 L 50 15 Z" fill="#52b788" stroke="#1b4332" stroke-width="1.5"/>
            <circle cx="50" cy="55" r="7" fill="#f97316" />
          </svg>
        </div>
        <p class="subtitle">اضغط على الظرف لفتح الرسالة ✨</p>
      </div>

      <div id="letter-content" class="letter-content">
        <p class="letter-text">
          <!--ضع نص الرسالة المكتوبة هنا بين الكلمتين-->
          ضع الرسالة المكتوبة هنا.. اكتب كل الكلام والتفاصيل الحلوة اللي تبغى تقولها!
          <!--انتهى نص الرسالة المكتوبة-->
        </p>
      </div>

      <button class="back-btn" onclick="goHome()">رجوع</button>
    </div>

    <!-- PAGE 3: WHY YOU GENERATOR -->
    <div id="page-3" class="page">
      <h2 class="title-arabic">ليش أنت بالذات؟ ✨</h2>
      <p class="subtitle">اضغط على الزر تحت عشان تعرف سبب جديد!</p>
      
      <div class="reason-box" id="reason-display">
        اضغط تحت واكتشف الأسباب! 🧡
      </div>

      <button class="action-btn" onclick="generateReason()">اعطيني سبب ثاني 🪄</button>
      <br>
      <button class="back-btn" onclick="goHome()">رجوع</button>
    </div>

    <!-- PAGE 4: VOICE MESSAGE VINYL -->
    <div id="page-4" class="page">
      <h2 class="title-arabic">رسالة بصوتي لك 🎙️</h2>
      <p class="subtitle">شغّل الاسطوانة واسمع ايش جهزت لك</p>

      <div class="vinyl-container">
        <div class="vinyl-record" id="vinyl">
          <div class="vinyl-center">
            <i class="fa-solid fa-heart"></i>
          </div>
        </div>
      </div>

      <!-- ضع رابط التسجيل الصوتي هنا داخل المزدوجتين بدل العبارة العربية -->
      <audio id="voice-audio" src="ضع_رابط_التسجيل_الصوتي_هنا"></audio>

      <button class="action-btn" id="play-btn" onclick="toggleAudio()">تشغيل الرسالة ▶️</button>
      <br>
      <button class="back-btn" onclick="goHome()">رجوع</button>
    </div>

  </div>

  <script>
    const visitedGifts = new Set();

    function openGift(id) {
      visitedGifts.add(id);
      document.getElementById('btn-' + id).classList.add('visited');

      document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
      document.getElementById('page-' + id).classList.add('active');
    }

    function openSpotify() {
      visitedGifts.add(2);
      document.getElementById('btn-2').classList.add('visited');
      
      /* ضع رابط بلايليست سبوتيفاي هنا داخل المزدوجتين بدل الرابط الحالي */
      window.open('ضع_رابط_بلايليست_سبوتيفاي_هنا', '_blank');
    }

    function goHome() {
      document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
      document.getElementById('home-page').classList.add('active');
      pauseAudio();
    }

    function openLetterAnimation() {
      document.getElementById('envelope-wrapper').style.display = 'none';
      document.getElementById('letter-content').style.display = 'block';
    }

    /* يمكنك إضافة أو تعديل الأسباب هنا بين المزدوجتين */
    const reasons = [
      "ضع السبب الأول هنا 💚",
      "ضع السبب الثاني هنا 😂",
      "ضع السبب الثالث هنا ✨",
      "ضع السبب الرابع هنا 🎧",
      "ضع السبب الخامس هنا 🧡"
    ];

    function generateReason() {
      const randomIndex = Math.floor(Math.random() * reasons.length);
      const display = document.getElementById('reason-display');
      display.style.opacity = '0';
      setTimeout(() => {
        display.innerText = reasons[randomIndex];
        display.style.opacity = '1';
      }, 200);
    }

    /* التحكم بالرسالة الصوتية والاسطوانة */
    const audio = document.getElementById('voice-audio');
    const vinyl = document.getElementById('vinyl');
    const playBtn = document.getElementById('play-btn');

    function toggleAudio() {
      if (audio.paused) {
        audio.play();
        vinyl.classList.add('playing');
        playBtn.innerText = 'إيقاف مؤقت ⏸️';
      } else {
        pauseAudio();
      }
    }

    function pauseAudio() {
      audio.pause();
      vinyl.classList.remove('playing');
      playBtn.innerText = 'تشغيل الرسالة ▶️';
    }

    audio.onended = function() {
      vinyl.classList.remove('playing');
      playBtn.innerText = 'تشغيل الرسالة ▶️';
    };

    /* خلفية اللمعان */
    const canvas = document.getElementById('glitter-canvas');
    const ctx = canvas.getContext('2d');

    function resizeCanvas() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    const particles = [];
    const colors = ['#74c69d', '#52b788', '#f97316', '#ffedd5', '#ffffff'];

    for (let i = 0; i < 75; i++) {
      particles.push({
        x: Math.random() * canvas.width,
        y: Math.random() * canvas.height,
        size: Math.random() * 3.5 + 1,
        color: colors[Math.floor(Math.random() * colors.length)],
        opacity: Math.random(),
        speed: Math.random() * 0.02 + 0.005,
        direction: Math.random() < 0.5 ? 1 : -1
      });
    }

    function animateGlitter() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      particles.forEach(p => {
        p.opacity += p.speed * p.direction;
        if (p.opacity >= 1 || p.opacity <= 0.1) {
          p.direction *= -1;
        }

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fillStyle = p.color;
        ctx.globalAlpha = p.opacity;
        ctx.shadowBlur = 8;
        ctx.shadowColor = p.color;
        ctx.fill();
      });
      requestAnimationFrame(animateGlitter);
    }
    animateGlitter();
  </script>
</body>
</html>
